rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function isNonAnonymous() {
      return isSignedIn() && !isAnonymous();
    }

    match /gameTemplates/{templateId} {
      allow read: if isSignedIn();
      allow create: if isNonAnonymous() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isNonAnonymous() && resource.data.ownerUid == request.auth.uid;
    }

    match /sessions/{sessionCode} {
      allow read: if isSignedIn();
      allow create: if isNonAnonymous() && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if isNonAnonymous() && resource.data.hostUid == request.auth.uid;

      match /players/{playerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if isSignedIn() && (
          request.auth.uid == resource.data.uid ||
          get(/databases/$(database)/documents/sessions/$(sessionCode)).data.hostUid == request.auth.uid
        );
        allow delete: if isNonAnonymous() &&
          get(/databases/$(database)/documents/sessions/$(sessionCode)).data.hostUid == request.auth.uid;
      }
    }
  }
}
